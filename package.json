{
  "name": "theboringarchitecture",
  "version": "0.1.0",
  "description": "The Boring Architecture — a fullstack starter for Express, Inertia, and React.",
  "main": "app/index.js",
  "type": "module",
  "scripts": {
    "build": "npm run build:client && npm run build:ssr",
    "build:client": "vite build",
    "build:ssr": "vite build --config vite.ssr.config.mjs",
    "db:seed": "mikro-orm seeder:run",
    "migrate": "npm run migration:create && npm run migration:run",
    "migration:create": "mikro-orm migration:create",
    "migration:revert": "mikro-orm migration:down",
    "migration:run": "mikro-orm migration:up",
    "migration:status": "mikro-orm migration:check",
    "pages:generate": "sh bin/generate-pages.sh",
    "pages:watch": "chokidar \"app/views/pages/**/*.jsx\" -c \"npm run pages:generate\" --initial",
    "prebuild": "npm run pages:generate",
    "prestart:dev": "npm run pages:generate && npm run build:ssr",
    "prestart:prod": "npm run pages:generate && npm run build:client && npm run build:ssr",
    "start:dev": "concurrently --names \"pages,server,client,ssr\" --prefix-colors \"yellow,cyan,magenta,blue\" \"npm run pages:watch\" \"npm run start:dev:server\" \"npm run start:dev:client\" \"npm run start:dev:ssr\"",
    "start:dev:client": "vite build --watch",
    "start:dev:server": "nodemon",
    "start:dev:ssr": "vite build --config vite.ssr.config.mjs --watch",
    "start:prod": "node app/index.js",
    "test": "vitest run",
    "work:dev": "node app/worker.js",
    "work:prod": "node app/worker.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@inertiajs/react": "^2.1.11",
    "@mikro-orm/core": "^6.5.8",
    "@mikro-orm/migrations": "^6.5.1",
    "@mikro-orm/postgresql": "^6.5.1",
    "@mikro-orm/seeder": "^6.5.1",
    "@mikro-orm/sqlite": "^6.5.8",
    "bcrypt": "^6.0.0",
    "better-queue": "^3.8.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "dotenv-defaults": "^5.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.2",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "lucide-react": "^1.27.0",
    "node-cron": "^4.5.0",
    "nodemailer": "^8.0.5",
    "pg-connection-string": "^2.9.1",
    "pino-http": "^10.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "3.4.17",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.5.1",
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.10.31",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.1",
    "postcss": "^8.5.6",
    "rimraf": "^6.0.1",
    "supertest": "^7.2.2",
    "vite": "^6.4.0",
    "vitest": "^4.1.7"
  },
  "mikro-orm": {
    "configPaths": [
      "./config/orm.config.js"
    ]
  }
}
